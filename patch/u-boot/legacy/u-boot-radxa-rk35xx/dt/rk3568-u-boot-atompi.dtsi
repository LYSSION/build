&pcie30phy {
	
	status = "okay";
};

&pcie3x2 {
	
	status = "okay";
};

&pinctrl {
	u-boot,dm-spl;
	status = "okay";
};

&gpio0 {
	u-boot,dm-spl;
};

&gpio1 {
	u-boot,dm-spl;
