&gmac1_stmmac_axi_setup {
	
};

&gmac1_mtl_rx_setup {
	
	queue0 {
		
	};
};

&gmac1_mtl_tx_setup {
	
	queue0 {
		
	};
};

&mdio0 {
	
	rgmii_phy0: phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		
		reg = <0x0>;
	};
};

&mdio1 {
	
	rgmii_phy1: phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		
		reg = <0x0>;
	};
};

&gmac0_miim {
	
};

&gmac0_clkinout {
	
};

&gmac0_rx_bus2 {
	
